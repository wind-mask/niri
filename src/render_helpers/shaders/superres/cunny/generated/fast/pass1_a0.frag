// CuNNy fast-NVL, pass 1 (in (1x12)), output channels 0..3.
//
// Generated by src/render_helpers/shaders/superres/cunny/generate.py, from the
// Magpie effect of https://github.com/Blinue/CuNNy (commit dc3f51aa, GPL-3.0), whose
// weights are trained by https://github.com/funnyplanter/CuNNy. Do not edit this
// file: change the generator or the effect instead.
//
// See the generator's docstring for what the port does differently from the
// reference, and superres.rs for how the passes are run and cached.

precision highp float;

uniform sampler2D tex;
// Size of the client buffer in texels, and the rect of it being resampled.
uniform vec2 niri_tex_size;
uniform vec4 niri_src_rect;
varying vec2 v_coords;

// Samples the neighboring texel `off` from the center of the current one.
vec4 niri_tap0(vec2 pos, vec2 off) {
    vec2 lo = niri_src_rect.xy + vec2(0.5);
    vec2 hi = niri_src_rect.xy + niri_src_rect.zw - vec2(0.5);
    vec2 t = clamp(pos + off, lo, hi);
    vec4 c = texture2D(tex, t / niri_tex_size);
    vec3 rgb = c.a > 0.0 ? c.rgb / c.a : c.rgb;
    return vec4(rgb, c.a);
}

// Rec.601 luma, which is all that the input layer of this network sees.
float niri_luma(vec2 pos) {
    vec2 lo = niri_src_rect.xy + vec2(0.5);
    vec2 hi = niri_src_rect.xy + niri_src_rect.zw - vec2(0.5);
    vec2 t = clamp(pos, lo, hi);
    vec4 c = texture2D(tex, t / niri_tex_size);
    vec3 rgb = c.a > 0.0 ? c.rgb / c.a : c.rgb;
    return dot(vec3(0.299, 0.587, 0.114),
               rgb);
}

