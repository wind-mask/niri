vec4 niri_tap0(vec2 pos, vec2 off) {
    vec2 lo = niri_src_rect.xy + vec2(0.5);
    vec2 hi = niri_src_rect.xy + niri_src_rect.zw - vec2(0.5);
    vec2 t = clamp(pos + off, lo, hi);
    vec4 c = texture2D(tex, t / niri_tex_size);
    vec3 rgb = c.a > 0.0 ? c.rgb / c.a : c.rgb;
    return vec4(rgb, c.a);
}

